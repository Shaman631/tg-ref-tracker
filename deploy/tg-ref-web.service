[Unit]
Description=Telegram referral tracker — веб-сервис (страница управления)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/tg-ref
EnvironmentFile=-/etc/tg-ref.env
Environment=PORT=8080
ExecStart=/usr/bin/php -S 127.0.0.1:8080 -t /opt/tg-ref /opt/tg-ref/index.php
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
