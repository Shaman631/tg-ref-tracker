# Настройки для systemd-служб. Скопируйте в /etc/tg-ref.env и поставьте права 600.
# Значения можно вынести в /opt/tg-ref/config.local.php — тогда этот файл не нужен.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA-замените-на-свой-токен

# Куда присылать отчёты (ваш chat_id)
CHAT_ID=123456789

# Каналы через запятую
CHANNELS=@my_channel,@second_channel

# Расписание и часовой пояс
SCHEDULE_TIME=21:00
TZ=Europe/Samara

# Где хранить состояние (на диске VPS переживает перезагрузки)
STATE_FILE=/var/lib/tg-ref/state.json
